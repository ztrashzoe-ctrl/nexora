# Set these as environment variables in your hosting provider. Do not commit real secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
DISCORD_CLIENT_ID=your-discord-application-client-id
DISCORD_CLIENT_SECRET=your-discord-application-client-secret
DISCORD_REDIRECT_URI=https://YOUR-APP.onrender.com/auth/discord/callback
APP_URL=https://YOUR-APP.onrender.com
NODE_ENV=production
